# Base de données Postgres (production). Exemple avec Neon, Supabase, Railway...
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Pour tester en local avec SQLite à la place, changez le provider dans
# prisma/schema.prisma en "sqlite" et utilisez plutôt :
# DATABASE_URL="file:./dev.db"

# Email du compte qui a accès au panneau super-admin (/admin), où l'on voit
# et gère TOUTES les boutiques de la plateforme (plan, visibilité...).
# Mettez ici l'email exact que vous utilisez pour vous connecter.
SUPER_ADMIN_EMAIL="votre-email@exemple.com"

# Paiement par carte (Konnect — passerelle tunisienne). Optionnel : sans ces
# variables, seul le paiement à la livraison est proposé aux clients.
# Créez un compte sur https://konnect.network pour obtenir ces valeurs.
KONNECT_API_KEY=""
KONNECT_WALLET_ID=""
KONNECT_BASE_URL="https://api.sandbox.konnect.network/api/v2"
# Utilisé aussi pour les paiements d'abonnement (Pro/Premium) automatiques —
# voir lib/plans.ts pour les tarifs (29 DT Pro, 59 DT Premium).

# Notifications par email au propriétaire de la boutique (nouvelle commande).
# Optionnel : sans ces variables, les notifications sont juste désactivées.
# Créez un compte gratuit sur https://resend.com pour obtenir la clé API.
RESEND_API_KEY=""
EMAIL_FROM="MaBoutique Repair <notifications@votredomaine.tn>"

# URL publique du site, utilisée pour générer le sitemap.xml (SEO)
SITE_URL="https://maboutique-repair.vercel.app"

# Clé secrète utilisée pour signer les sessions (changez-la en production)
JWT_SECRET="changez-cette-cle-secrete-en-production"
